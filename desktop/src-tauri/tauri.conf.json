{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "58:12 Connect",
  "version": "0.1.0",
  "identifier": "org.5812-global.connect",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "58:12 Connect",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "url": "http://127.0.0.1:8001/",
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../resources/backend/": "backend/",
      "../resources/mongo/": "mongo/",
      "../resources/cloudflared/": "cloudflared/"
    },
    "category": "Productivity",
    "shortDescription": "58:12 Connect — self-hosted CRM",
    "longDescription": "Self-hosted desktop bundle of 58:12 Connect. Spawns a local FastAPI backend + portable MongoDB, optionally exposes the app over a Cloudflare Named Tunnel for remote access."
  }
}
